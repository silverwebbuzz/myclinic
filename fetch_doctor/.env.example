# Copy to .env on the server. Never commit .env.

# Required: Google Maps API key with Places enabled.
# Console: https://console.cloud.google.com → APIs & Services
#
# Enable BOTH (fetch_doctor uses legacy + Places API New as fallback):
#   • Places API          (legacy — Text Search, Find Place, Details)
#   • Places API (New)    (searchText — used when legacy is denied)
#
# Billing must be on. Set a daily budget alert under Billing → Budgets.
#
# Key restrictions for fetch_doctor (server-side PHP):
#   ✓ "IP addresses" → your server’s public IP
#   ✗ NOT "HTTP referrers" only (that breaks server calls → REQUEST_DENIED)
GOOGLE_MAPS_API_KEY=

# Optional DB override. Leave blank to read from ../app/.env (preferred).
# DB_HOST=127.0.0.1
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
