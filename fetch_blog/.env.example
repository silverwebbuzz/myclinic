# =====================================================================
# fetch_blog/.env  — fill these on the SERVER only. Never commit this
# file (fetch_blog/.env is in the repo .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# 1) CLAUDE (Anthropic) — writes the blog text
# ---------------------------------------------------------------------
# Where to get it:
#   • Go to https://console.anthropic.com
#   • Left menu → "API Keys" → "Create Key"
#   • Copy the key (starts with sk-ant-...). It is shown only once.
#   • Make sure the account has billing/credits: Console → Billing.
ANTHROPIC_API_KEY=

# Model used for writing. claude-opus-4-8 = best quality (recommended).
# If you want cheaper drafts later, change to: claude-sonnet-5
CLAUDE_MODEL=claude-opus-4-8

# ---------------------------------------------------------------------
# 2) GEMINI (Google AI) — generates the hero image
# ---------------------------------------------------------------------
# Where to get it:
#   • Go to https://aistudio.google.com/apikey  (login with your
#     Google account that has the Gemini plan)
#   • "Create API key" → pick/create a Google Cloud project → copy key.
# NOTE: this is the AI Studio key (free tier works for images with
# limits), NOT the Google Maps key used by fetch_doctor.
GEMINI_API_KEY=

# Image model. gemini-2.5-flash-image is Google's image-generation
# model ("Nano Banana") — best at clean graphics per our AI-stack plan.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---------------------------------------------------------------------
# 3) WORDPRESS (your live blog server, separate DB) — receives drafts
# ---------------------------------------------------------------------
# WP_BASE_URL: the WordPress root, WITHOUT trailing slash.
#   Your blog lives at eclinicpro.com/blog, so:
WP_BASE_URL=https://eclinicpro.com/blog

# WP_USERNAME: the wp-admin username of an Editor/Administrator user.
WP_USERNAME=

# WP_APP_PASSWORD: NOT the normal login password!
# Where to get it:
#   • Log in to wp-admin on the blog
#   • Users → Profile (of the user above) → scroll to
#     "Application Passwords" → name it "fetch_blog" → "Add New"
#   • Copy the generated password (looks like: abcd efgh ijkl mnop qrst uvwx)
#     Spaces are OK — paste it exactly as shown.
# If the "Application Passwords" section is missing, the site must be
# on HTTPS and WordPress 5.6+; some security plugins disable it —
# re-enable it in the plugin settings.
WP_APP_PASSWORD=

# Posts are created with this status. Keep "draft" — you review and
# publish manually in wp-admin.
WP_POST_STATUS=draft

# ---------------------------------------------------------------------
# 4) TOOL ACCESS + LINKS
# ---------------------------------------------------------------------
# Simple password so random visitors can't open this tool or burn your
# API credits. Set any random string, then open the page as:
#   https://yoursite.com/fetch_blog/?key=THAT_STRING
TOOL_KEY=

# Main eClinicPro site — used inside each blog for the
# "Consult a verified doctor" CTA links (no trailing slash).
MAIN_SITE_URL=https://eclinicpro.com
