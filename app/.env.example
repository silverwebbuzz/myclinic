APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_BASE_DOMAIN=app.manageclinic.com
DEV_CLINIC_SLUG=demo
APP_KEY=change-me-to-random-32-char-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=manageclinic
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

SUPERADMIN_JWT_SECRET=change-me-superadmin-secret-min-32-chars
SUPERADMIN_JWT_TTL_MINUTES=480
PLATFORM_ADMIN_EMAIL=admin@manageclinic.com
PLATFORM_ADMIN_PASSWORD=ChangeMe!Admin123

MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_FROM=noreply@eclinicpro.com

# App email delivery: when MAILGUN_* is blank, the clinic app uses SMTP below.
# Marketing site (book-a-demo, contact) also uses these via partials/mailer.php.
# Care/relationship mail (staff invites, win-back), support/billing, health
# content/newsletters, and automated/system mail (OTP, welcome, reminders,
# receipts, password reset). Replies to system mail go to WECARE_FROM.
WECARE_FROM=wecare@eclinicpro.com
HELP_FROM=help@eclinicpro.com
HEALTHTIPS_FROM=healthtips@eclinicpro.com
NOREPLY_FROM=noreply@eclinicpro.com

# BCC archive: one copy of every outbound email to this inbox.
# Portal (Mailgun) + marketing site (SMTP). Leave blank to disable.
MAIL_ARCHIVE_BCC=eclinicpro.com@gmail.com

# SMTP — primary delivery for app + marketing site when Mailgun is not set.
# SMTP_SECURE = "ssl" for port 465, "tls" for 587.
SMTP_HOST=mail.eclinicpro.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=wecare@eclinicpro.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=wecare@eclinicpro.com
SMTP_FROM_NAME=eClinicPro Care Team
SMTP_TO_EMAIL=wecare@eclinicpro.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cashfree — PRIMARY gateway for clinic/doctor plan subscriptions.
# Razorpay above is the fallback when these are blank. CASHFREE_ENV =
# "sandbox" for testing, "production" to go live. Set the webhook URL in the
# Cashfree dashboard to: <APP_URL>/webhooks/cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
